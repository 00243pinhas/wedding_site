NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely. Server-side only — never prefix with NEXT_PUBLIC_,
# never import into a "use client" file. See CLAUDE.md non-negotiables.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the guest_session cookie set by /i/[code] so it can't be forged.
# Any long random string — e.g. `openssl rand -hex 32`. Server-side only.
COOKIE_SECRET=

# Bypass code for the couple and the developer to view the live site
# without a guests row — checked in verifyInviteCode before the database
# lookup. Never NEXT_PUBLIC_, never logged. Any long random string, distinct
# from any real guest invite code — e.g. `openssl rand -hex 16`.
OWNER_ACCESS_CODE=
