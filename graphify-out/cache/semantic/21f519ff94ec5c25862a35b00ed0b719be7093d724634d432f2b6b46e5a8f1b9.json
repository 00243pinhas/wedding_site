{"nodes": [{"id": "claude_skills_wedding_design_skill", "label": "Wedding Site Design System (SKILL.md)", "file_type": "document", "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_wedding_design_skill_colour_palette", "label": "Colour Palette (ivory/navy/blue/blush/pink/ink)", "file_type": "concept", "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blush fills only on ivory and outlines only on photography; navy is never used for body copy because it fails contrast at body size. Roughly 70% ivory / 20% blue+navy / 10% pink+blush keeps the register restrained and editorial rather than 'cute wedding template'."}, {"id": "claude_skills_wedding_design_skill_typography", "label": "Typography System (Cormorant Garamond + Inter)", "file_type": "concept", "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_wedding_design_skill_shape", "label": "Shape Rules (no rounded corners, no shadows/gradients)", "file_type": "rationale", "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rounding is called out as 'the single fastest way to make this look like a template.' Separation must come from colour bands and whitespace instead of drop shadows, gradients, or glow; borders stay hairline (1px, blue)."}, {"id": "claude_skills_wedding_design_skill_hero", "label": "Hero Section Spec", "file_type": "concept", "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_wedding_design_skill_section_rhythm", "label": "Section Rhythm (Ivory/Wash/Tint bands)", "file_type": "concept", "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_wedding_design_skill_motion", "label": "Motion System (framer-motion + lenis, Reveal, reduced-motion)", "file_type": "rationale", "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Motion must stay slow and physical, never bouncy or springy, so it never draws attention to itself. Only transform and opacity are animated to avoid dropped frames on older phones. prefers-reduced-motion disables everything with no exceptions, and Lenis is not even instantiated under reduced motion."}, {"id": "claude_skills_wedding_design_skill_signature_moment", "label": "Signature Moment (SVG line-drawing divider animation)", "file_type": "concept", "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately limited to one flourish (a thin navy botanical/ring line-drawing on stroke-dashoffset that plays once) so the site does not accumulate ten small animations that dilute the effect."}, {"id": "claude_skills_wedding_design_skill_structure", "label": "Site Structure (long-scroll homepage + fast utility pages)", "file_type": "concept", "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Practical content (address, gallery, FAQ, gifts, contact) is split onto fast findable pages so a guest checking the address at 4pm on the wedding day is not forced to scroll the emotional homepage."}], "edges": [{"source": "claude_skills_wedding_design_skill", "target": "claude_skills_wedding_design_skill_colour_palette", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_wedding_design_skill", "target": "claude_skills_wedding_design_skill_typography", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_wedding_design_skill", "target": "claude_skills_wedding_design_skill_shape", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_wedding_design_skill", "target": "claude_skills_wedding_design_skill_hero", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_wedding_design_skill", "target": "claude_skills_wedding_design_skill_section_rhythm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_wedding_design_skill", "target": "claude_skills_wedding_design_skill_motion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_wedding_design_skill", "target": "claude_skills_wedding_design_skill_signature_moment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_wedding_design_skill", "target": "claude_skills_wedding_design_skill_structure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_wedding_design_skill_hero", "target": "claude_skills_wedding_design_skill_motion", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/wedding-design/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "wedding_design_system_concepts", "label": "Wedding Site Design System (palette, typography, shape, hero, section rhythm, motion, signature moment, structure)", "nodes": ["claude_skills_wedding_design_skill_colour_palette", "claude_skills_wedding_design_skill_typography", "claude_skills_wedding_design_skill_shape", "claude_skills_wedding_design_skill_hero", "claude_skills_wedding_design_skill_section_rhythm", "claude_skills_wedding_design_skill_motion", "claude_skills_wedding_design_skill_signature_moment", "claude_skills_wedding_design_skill_structure"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/wedding-design/SKILL.md"}]}